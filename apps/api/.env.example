# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad?schema=public

# Redis 7 (optional locally - API degrades gracefully if unreachable)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MIN=30
INVITATION_TTL_DAYS=7

# Billing
BILLING_WEBHOOK_SECRET=change-me-webhook-secret

# Mail (console transport is used unless SMTP_HOST is set)
MAIL_FROM=LaunchPad <no-reply@launchpad.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Rate limiting (fixed window, Redis-backed)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
